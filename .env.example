# ==========================================
# IA Gratuita (Google Gemini API)
# ==========================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_PROVIDER=gemini

# ==========================================
# Banco de Dados (Supabase Postgres)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ==========================================
# Segurança & Sessão
# ==========================================
# Gere uma string aleatória segura com >= 32 caracteres (ex: openssl rand -hex 32)
SESSION_SECRET=

# "vault" (Cofre único com PIN) ou "supabase" (Multi-usuário futuro)
AUTH_MODE=vault

# UUID do dono padrão no modo vault (opcional — gerado automaticamente no setup)
VAULT_OWNER_ID=
